#include <iostream>
#include <vector>
#include <numeric>
#include <algorithm>

using namespace std;

void solve() {
    int n;
    long long k;
    cin >> n >> k;
    
    vector<long long> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    long long sum = 0;
    long long max_val = 0;
    int max_items = 0;

    for (int i = 0; i < n; i++) {
        sum += arr[i];
        max_val = max(max_val, arr[i]);


        if (sum - max_val <= k) {
            max_items = i + 1;
        } else {
            break;
        }
    }

    cout << max_items << "\n";
}

int main() {
   
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}