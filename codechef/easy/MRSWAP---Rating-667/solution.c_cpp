#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int n;
    cin>>n;
   int arr[2*n];
   
    for(int i=0;i<2*n;i++) cin>>arr[i];
    
    for(int i=0;i<n;i++){
        if(arr[i]<arr[2*n-i-1]){
            swap(arr[i],arr[2*n-1-i]);
        }
    } int sum=0;
    for(int i=0;i<n;i++){
        sum+=arr[i];
} cout<<sum<<endl;
} return 0;
}
