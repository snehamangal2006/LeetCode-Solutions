
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int odd = 0, even = 0;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            if (x % 2 != 0) odd++;
            else even++;
        }   

        if (odd == 0 || even == 0) {
            cout << 1 << "\n";
        } else if (odd == even) {
            cout << 2 * odd << "\n";
        } else {
            cout << 2 * min(odd, even) + 1 << "\n";
        }
    }
    return 0;
}