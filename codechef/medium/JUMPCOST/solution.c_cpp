#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<int> A(N + 1);

        long long sum = 0;
        long long ans = 0;

        for (int i = 1; i <= N; i++)
            cin >> A[i];

        for (int i = 2; i <= N; i++) {
            if (A[i] > 0)
                sum += A[i];

            ans = max(ans, sum - i + 1);
        }

        cout << ans << '\n';
    }
}