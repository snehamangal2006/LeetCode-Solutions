#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int X, Y, P;
        cin >> X >> Y >> P;

        int count = 0;

        while (1LL * X * Y < P) {
            if (X < Y)
                X++;
            else
                Y++;
            count++;
        }

        cout << count << endl;
    }

    return 0;
}