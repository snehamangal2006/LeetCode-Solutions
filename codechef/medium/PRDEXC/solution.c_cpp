#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
    cin >> t;

    while (t--) {
        int X, Y, P;
        cin >> X >> Y >> P;
        int count=0;
        int maxi = max(X,Y);
        int mini = min(X,Y);
        while(X*Y<P){
            if(( mini*(maxi+1)) >= P)
            count++;
        } cout<<count<<endl;
} return 0;
}
