#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int X, Y, Z;
        cin >> X >> Y >> Z;

        if (Z <= Y) {
            cout << -1 << endl;
            continue;
        }

        int price = X;
        int coins = 0;
        int months = 0;

        while (coins < price) {
            months++;
            price += Y;
            coins += Z;
        }

        cout << months << endl;
    }

    return 0;
}